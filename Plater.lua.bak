					["Icon"] = 132177,
					["LastHookEdited"] = "Constructor",
				}, -- [22]
				{
					["Enabled"] = true,
					["Revision"] = 351,
					["HooksTemp"] = {
					},
					["Author"] = "Izimode-Azralon",
					["Desc"] = "Add a border around the current target.",
					["Hooks"] = {
						["Nameplate Added"] = "function (self, unitId, unitFrame, envTable)\n    envTable.UpdateBorder (unitFrame)\nend\n\n\n",
						["Target Changed"] = "function (self, unitId, unitFrame, envTable)\n    envTable.UpdateBorder (unitFrame)\nend\n\n\n",
						["Constructor"] = "function (self, unitId, unitFrame, envTable)\n    \n    --border options\n    local borderSize = 1.5\n    local borderColor = \"white\" --\"#FF808080\"\n    local xOffset = 0\n    local yOffset = 0\n    \n    \n    if (not unitFrame.healthBar.TargetBorder) then\n        unitFrame.healthBar.TargetBorder = CreateFrame (\"frame\", nil, unitFrame.healthBar, \"NamePlateFullBorderTemplate\")\n    end\n    \n    function envTable.UpdateBorder (unitFrame,casting)\n        if unitFrame.unit and (UnitIsUnit (\"target\", unitFrame.unit)) then            \n            casting = casting or UnitCastingInfo(\"target\")\n            local r, g, b, a = DetailsFramework:ParseColors (borderColor)\n            unitFrame.healthBar.TargetBorder:SetVertexColor (r, g, b, 0.8)\n            unitFrame.healthBar.TargetBorder:ClearAllPoints()\n            local x1 = casting and -1*(xOffset+21) or -1*xOffset \n            local y1 = yOffset\n            local x2 = casting and 0+xOffset or xOffset\n            local y2 = casting and -1*(yOffset+11) or -1*yOffset\n            unitFrame.healthBar.TargetBorder:SetPoint(\"TOPLEFT\",unitFrame.healthBar,\"TOPLEFT\",x1,y1)\n            unitFrame.healthBar.TargetBorder:SetPoint(\"BOTTOMRIGHT\",unitFrame.healthBar,\"BOTTOMRIGHT\",x2,y2)\n            unitFrame.healthBar.TargetBorder:SetBorderSizes (borderSize, borderSize, borderSize, borderSize)\n            unitFrame.healthBar.TargetBorder:UpdateSizes()\n            unitFrame.healthBar.TargetBorder:Show()\n            \n        else\n            unitFrame.healthBar.TargetBorder:Hide()\n        end\n    end\n    \n    \nend",
						["Destructor"] = "function (self, unitId, unitFrame, envTable)\n    if (unitFrame.healthBar.TargetBorder) then\n        unitFrame.healthBar.TargetBorder:Hide()\n    end\nend",
						["Cast Start"] = "function (self, unitId, unitFrame, envTable)\n    if envTable.timer then envTable.timer:Cancel() end\n    envTable.UpdateBorder (unitFrame,true)    \nend\n\n\n",
						["Cast Stop"] = "function (self, unitId, unitFrame, envTable)\n    local duration = self.interrupted and 1.00 or 0.28\n    local envTable = envTable\n    envTable.timer = C_Timer.NewTimer(duration, function() \n            envTable.UpdateBorder(unitFrame)\n    end)\nend\n\n\n",
					},
					["Prio"] = 99,
					["Time"] = 1579213506,
					["PlaterCore"] = 1,
					["LoadConditions"] = {
						["talent"] = {
						},
						["group"] = {
						},
						["class"] = {
						},
						["map_ids"] = {
