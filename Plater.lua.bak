					["UpdateCode"] = "function (self, unitId, unitFrame, envTable)\n    --insert code here\n    local health = UnitHealth(unitId)\n    local healthMax = UnitHealthMax(unitId)\n    local pct = health/healthMax\n    local stacks = envTable._StackCount\n    local stackPct = stacks/30\n    \n    if  (stacks<20 and stackPct-0.2<pct) or stacks<10 then\n        Plater.SetNameplateColor (unitFrame, 0,1,0)\n    else        \n        Plater.RefreshNameplateColor (unitFrame)\n    end\n    \n    \n    \nend",
