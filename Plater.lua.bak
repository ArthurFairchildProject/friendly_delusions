						167385, -- [1]
					},
					["Temp_UpdateCode"] = "function (self, unitId, unitFrame, envTable)\n    --insert code here\nend\n\n\n",
					["Name"] = "Spell Cooldown in Extra frame",
					["PlaterCore"] = 1,
					["Icon"] = 136222,
					["Temp_OnHideCode"] = "function (self, unitId, unitFrame, envTable)\n    --insert code here\n    local extraFrame = unitFrame.customExtraIconFrame\n    --extraFrame:Hide()\nend",
					["OnShowCode"] = "function (self, unitId, unitFrame, envTable)\n    \n    local extraFrame = unitFrame.customExtraIconFrame\n    \n    local spellId = 167385    \n    local borderColor = Plater.db.profile.extra_icon_border_color\n    local expirationTime = GetTime()+10\n    local duration = 10\n    local count = 1\n    local debuffType = \"\"\n    local caster\n    local canStealOrPurge\n    --spellId, borderColor, startTime, duration, forceTexture, descText\n    extraFrame:SetIcon (spellId, borderColor, expirationTime - duration, duration, false, false, count, debuffType, caster, canStealOrPurge)\n    extraFrame:Show()\n    --add the spell into the cache\n    extraFrame.AuraCache [spellId] = true\n    \nend\n\n\n",
					["Prio"] = 99,
				}, -- [22]
				{
					["ConstructorCode"] = "function (self, unitId, unitFrame, envTable)\n    \n    \n    \n    local shortenNumber = function(number, significant)\n        if type(number) ~= \"number\" then\n            number = tonumber(number)\n        end\n        if not number then\n            return\n        end\n        \n        if type(significant) ~= \"number\" then\n            significant = tonumber(significant)\n        end\n        significant = significant or 3\n        \n        local affixes = {\n            \"k\",\n            \"m\",\n            \"b\",\n            \"t\",\n        }\n        affixes[0] = \"\"\n        \n        local log, floor, max, abs = math.log, math.floor, math.max, math.abs\n        \n        local powerTen = floor(log(abs(number)) / log(10)) --get the log base 10\n        powerTen = powerTen < 0 and 0 or powerTen --catch negative powers for numbers with an absolute value below 1\n        local affix = floor(powerTen / 3) --every third power of ten (so thousands) results in a new affix\n        local divNum = number / 1000^affix --get the \"new\" number by division with the floored amounts\n        local before = powerTen%3 + 1 --determine how many digits before the .\n        local after = max(0, significant - before) --and how many digits after\n        \n        return string.format(string.format(\"%%.%df%s\", after, affixes[affix]), divNum)\n    end\n    \n    \n    envTable.absorbFunc= function()\n        local absorbs = UnitGetTotalAbsorbs(unitId)\n        if absorbs>0 then return shortenNumber(UnitGetTotalAbsorbs(unitId)) end\n    end\n    \nend",
					["OnHideCode"] = "function (self, unitId, unitFrame, envTable)\n    --insert code here\n    \nend\n\n\n",
					["Temp_OnShowCode"] = "function (self, unitId, unitFrame, envTable)\n    --insert code here\n    \nend\n\n\n",
					["ScriptType"] = 1,
					["UpdateCode"] = "function (self, unitId, unitFrame, envTable)\n    local text = envTable.absorbFunc()\n    if text then\n        unitFrame.healthBar.lifePercent:SetText(text)\n    end\nend",
					["Time"] = 1578892412,
					["Temp_ConstructorCode"] = "function (self, unitId, unitFrame, envTable)\n    \n    \n    \n    local shortenNumber = function(number, significant)\n        if type(number) ~= \"number\" then\n            number = tonumber(number)\n        end\n        if not number then\n            return\n        end\n        \n        if type(significant) ~= \"number\" then\n            significant = tonumber(significant)\n        end\n        significant = significant or 3\n        \n        local affixes = {\n            \"k\",\n            \"m\",\n            \"b\",\n            \"t\",\n        }\n        affixes[0] = \"\"\n        \n        local log, floor, max, abs = math.log, math.floor, math.max, math.abs\n        \n        local powerTen = floor(log(abs(number)) / log(10)) --get the log base 10\n        powerTen = powerTen < 0 and 0 or powerTen --catch negative powers for numbers with an absolute value below 1\n        local affix = floor(powerTen / 3) --every third power of ten (so thousands) results in a new affix\n        local divNum = number / 1000^affix --get the \"new\" number by division with the floored amounts\n        local before = powerTen%3 + 1 --determine how many digits before the .\n        local after = max(0, significant - before) --and how many digits after\n        \n        return string.format(string.format(\"%%.%df%s\", after, affixes[affix]), divNum)\n    end\n    \n    \n    envTable.absorbFunc= function()\n        local absorbs = UnitGetTotalAbsorbs(unitId)\n        if absorbs>0 then return shortenNumber(UnitGetTotalAbsorbs(unitId)) end\n    end\n    \nend",
					["NpcNames"] = {
