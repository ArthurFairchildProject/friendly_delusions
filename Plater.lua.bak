				}, -- [19]
				{
					["Enabled"] = false,
					["Revision"] = 19,
					["OptionsValues"] = {
					},
					["HooksTemp"] = {
					},
					["Author"] = "Rehokk-Tarren Mill",
					["Name"] = "Raid Marker Colouring",
					["Desc"] = "Changes the nameplate colour based on the raid marker",
					["Hooks"] = {
						["Raid Target"] = "function (self, unitId, unitFrame, envTable)\n    \n    -- Blizzard don't have a table for this afaik. Lets create one.\n    -- values are r,g,b 0-1 \n    envTable.raidTargetColour = {\n        [8] = {1,1,1}, -- White Skull\n        [7] = {1,0,0}, -- Red Cross\n        [6] = {0,0.62,0.92}, -- Blue Square\n        [5] = {0.38,0.56,0.72}, -- White Crescent Moon\n        [4] = {0,1,0}, -- Green Triangle\n        [3] = {1,0,1}, -- Purple Diamond\n        [2] = {1,0.54, 0}, -- Orange Circle\n        [1]  = {1,1,0}, -- Yellow 4-Point Star\n    }\n    \n    -- You might be in combat so OnShow won't update it. \n    \n    -- Get the Raid Target ID and colour it from our envTable\n    if GetRaidTargetIndex(unitId) then\n        \n        Plater.SetNameplateColor (unitFrame, envTable.raidTargetColour[GetRaidTargetIndex(unitId)] )\n        \n    end\n    -- If not raid target then reset the colour\n    if not GetRaidTargetIndex(unitId) then\n        Plater.RefreshNameplateColor (unitFrame)\n    end\n    \n    \nend",
						["Nameplate Added"] = "function (self, unitId, unitFrame, envTable)\n    \n    -- Blizzard don't have a table for this afaik. Lets create one.\n    -- values are r,g,b 0-1 \n    envTable.raidTargetColour = {\n        [8] = {1,1,1}, -- White Skull\n        [7] = {1,0,0}, -- Red Cross\n        [6] = {0,0.62,0.92}, -- Blue Square\n        [5] = {0.38,0.56,0.72}, -- White Crescent Moon\n        [4] = {0,1,0}, -- Green Triangle\n        [3] = {1,0,1}, -- Purple Diamond\n        [2] = {1,0.54, 0}, -- Orange Circle\n        [1]  = {1,1,0}, -- Yellow 4-Point Star\n    }\n    \n    -- You might be in combat so OnShow won't update it. \n    \n    -- Get the Raid Target ID and colour it from our envTable\n    if GetRaidTargetIndex(unitId) then\n        \n        Plater.SetNameplateColor (unitFrame, envTable.raidTargetColour[GetRaidTargetIndex(unitId)] )\n        \n    end\n    -- If not raid target then reset the colour\n    if not GetRaidTargetIndex(unitId) then\n        Plater.RefreshNameplateColor (unitFrame)\n    end\n    \nend",
					},
