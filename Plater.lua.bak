								0.803921568627451, -- [3]
								1, -- [4]
							},
							["Name"] = "Font Color",
							["Icon"] = "Interface\\AddOns\\Plater\\images\\option_color",
							["Desc"] = "Color of the text.",
						}, -- [8]
						{
							["Type"] = 4,
							["Key"] = "outline",
							["Value"] = true,
							["Name"] = "Enable Text Outline",
							["Icon"] = "Interface\\AddOns\\Plater\\images\\option_bool",
							["Desc"] = "If enabled, the text uses outline.",
						}, -- [9]
					},
					["version"] = -1,
					["Name"] = "Unit - Show Energy [Plater]",
					["NpcNames"] = {
						"164406", -- [1]
						"164407", -- [2]
						"162100", -- [3]
						"162099", -- [4]
						"162329", -- [5]
						"164558", -- [6]
					},
				}, -- [30]
				{
					["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    \n    if(not unitFrame.demonTexture)then\n        unitFrame.demonTexture = unitFrame:CreateTexture(nil,\"ARTWORK\");\n        unitFrame.demonTexture:SetWidth(64);\n        unitFrame.demonTexture:SetHeight(64);\n        unitFrame.demonTexture:SetPoint(\"BOTTOM\",unitFrame,\"TOP\",0,3);\n    end\n    \n    if(not unitFrame.timerBar)then\n        unitFrame.timerBar = DetailsFramework:CreateBar(unitFrame);\n        unitFrame.timerBar:SetAllPoints(unitFrame.castBar);\n        unitFrame.timerBar:SetReverseFill();\n    end\nend\n\n\n\n\n",
					["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    unitFrame.demonTexture:Hide();\n    unitFrame.timerBar:Hide();\nend\n\n\n\n\n\n\n\n\n",
					["OptionsValues"] = {
					},
					["Temp_OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    \n    scriptTable.cleanUp();\n    \n    local demonData;\n    if(not scriptTable.currentlyActiveThings[envTable._UnitGUID])then\n        demonData = scriptTable.getRandomDemon();\n        \n        if(scriptTable.playSound)then\n            local useCombo = scriptTable.tableSize(scriptTable.currentlyActiveThings) > 0;\n            local combo = scriptTable.getCombo(demonData.name);\n            \n            if(useCombo and combo)then\n                PlaySoundFile(combo,\"MASTER\");\n            else\n                if(#demonData.soundPath > 0)then\n                    PlaySoundFile(demonData.soundPath[math.random(#demonData.soundPath)],\"MASTER\");\n                end\n            end\n        end\n        \n        demonData.startTime = GetTime();\n        demonData.currentTexture = demonData.texturePath[math.random(#demonData.texturePath)];\n        \n        scriptTable.currentlyActiveThings[envTable._UnitGUID] = demonData;\n    else\n        demonData = scriptTable.currentlyActiveThings[envTable._UnitGUID];\n    end\n    \n    if(scriptTable.showThingTimer and demonData.startTime + scriptTable.thingFullDuration > GetTime())then\n        unitFrame.timerBar:SetTimer(demonData.startTime,demonData.startTime + scriptTable.thingFullDuration);\n        unitFrame.timerBar:Show();\n    end\n    \n    unitFrame.demonTexture:SetTexture(demonData.currentTexture); \n    unitFrame.healthBar.unitName:SetText(scriptTable.currentlyActiveThings[envTable._UnitGUID].name);\n    unitFrame.demonTexture:Show();\nend",
					["ScriptType"] = 3,
					["Temp_Initialization"] = "function (scriptTable)\n    \n    scriptTable.showThingTimer = true;\n    scriptTable.playSound = true;   \n    \n    \n    -------------------------------------- DONT EDIT AFTER THIS LINE ------------------------------------------------\n    \n    local _;\n    scriptTable.currentlyActiveThings = {}; \n    scriptTable.thingFullDuration = 9.5;\n    \n    scriptTable.possibleDemons = {\n        \n        \n        {\n            name = \"Ivan\", \n            texturePath={\"Interface\\\\Icons\\\\Ivan2.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\NeckingSelf.ogg\",\n                \"Interface\\\\Sounds\\\\Ivan talk.ogg\",\n                \"Interface\\\\Sounds\\\\IvanRaider.ogg\",\n                \"Interface\\\\Sounds\\\\Ivan Tier.ogg\",\n                \"Interface\\\\Sounds\\\\Ivan Aura.ogg\"\n            }, \n            chance=5\n        },\n        {\n            name = \"Jahwa\", \n            texturePath={\"Interface\\\\Icons\\\\Jahwa.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Jahwa Shiet.ogg\",\n                \n            }, \n            chance=5\n        },\n        {\n            name = \"Wargazm\", \n            texturePath={\"Interface\\\\Icons\\\\Wargazm.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Wargazm Retired Warrior.ogg\",\n                --\"Interface\\\\Sounds\\\\CisHit.ogg\",\n            }, \n            chance=5\n        },\n        {\n            name = \"Cis\", \n            texturePath={\"Interface\\\\Icons\\\\Cis.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\CisWhy.ogg\",\n                \"Interface\\\\Sounds\\\\CisHit.ogg\",\n            }, \n            chance=5\n        },\n        {\n            name = \"Poli\", \n            texturePath={\"Interface\\\\Icons\\\\Poli.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Polirword.ogg\",\n                \"Interface\\\\Sounds\\\\Poli grand delusion.ogg\",\n                \"Interface\\\\Sounds\\\\Poli furry anime.ogg\",\n                \"Interface\\\\Sounds\\\\Poli not a weeb.ogg\",\n                \"Interface\\\\Sounds\\\\Poli guy who eats kids.ogg\",\n            }, \n            chance=5\n        },\n        {\n            name = \"Lang\",\n            texturePath={\"Interface\\\\Icons\\\\lang.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\langMan.ogg\",\n                \"Interface\\\\Sounds\\\\lang Laugh.ogg\",\n                \"Interface\\\\Sounds\\\\Lang I am sorry.ogg\",\n                \"Interface\\\\Sounds\\\\Lang my gear is broken.ogg\",\n                \"Interface\\\\Sounds\\\\Lang don't pull.ogg\",\n                \"Interface\\\\Sounds\\\\Lang not my fault.ogg\",\n                \"Interface\\\\Sounds\\\\Lang That is so toxic.ogg\",\n            },\n            \n            chance=5\n        },\n        {\n            name = \"Sarer\",\n            texturePath={\"Interface\\\\Icons\\\\sarer.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\sarerWhore.ogg\",\n                \"Interface\\\\Sounds\\\\sarerLikeSubComment.ogg\",\n                \"Interface\\\\Sounds\\\\Sarer I hate you.ogg\",\n            },\n            chance=5\n        },\n        {\n            name = \"Gem\",\n            texturePath={\"Interface\\\\Icons\\\\gem.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\gemOpenEye.ogg\",\n                \"Interface\\\\Sounds\\\\Gem Ara Ara.ogg\",\n                --\"Interface\\\\Sounds\\\\JulietGem.ogg\",\n            },\n            chance=5\n        },\n        {\n            name = \"Hooker\",\n            texturePath={\"Interface\\\\Icons\\\\ArthurW.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Arthur monkaS.ogg\",\n                \"Interface\\\\Sounds\\\\EZBoss.ogg\",\n                \"Interface\\\\Sounds\\\\Arthur hehe.ogg\",\n                \"Interface\\\\Sounds\\\\Arthur ph discord.ogg\",\n            },\n            chance=5\n        },\n        {\n            name = \"Madman\",\n            texturePath={\"Interface\\\\Icons\\\\Madman.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Madman Gosh.ogg\",\n                \"Interface\\\\Sounds\\\\MadmanLord.ogg\"\n            },\n            chance=5\n        },\n        {\n            name = \"Worben\",\n            texturePath={\"Interface\\\\Icons\\\\Worben.tga\"},\n            soundPath={\"Interface\\\\Sounds\\\\worbenShoulda.ogg\"},\n            chance=5\n        },\n        {\n            name = \"Seri\",\n            texturePath={\"Interface\\\\Icons\\\\Seri.tga\"},\n            soundPath={\n                -- \"Interface\\\\Sounds\\\\Seri on Worbens Shoulder.ogg\",\n                \"Interface\\\\Sounds\\\\Seri Solaz Angry.ogg\",\n                \"Interface\\\\Sounds\\\\Seri Yeeted.ogg\",\n            },\n            chance=5\n        },\n        {\n            name = \"Gump\",\n            texturePath={\"Interface\\\\Icons\\\\Gump.tga\"},\n            soundPath={\"Interface\\\\Sounds\\\\Gump Count.ogg\"},\n            chance=5\n        },\n        {\n            name = \"Shland\",\n            texturePath={\"Interface\\\\Icons\\\\Shland.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Shland Route.ogg\",\n                \"Interface\\\\Sounds\\\\Shland Touch my cc.ogg\"\n            },\n            chance=5\n        },\n        {\n            name = \"Bumlock\",\n            texturePath={\"Interface\\\\Icons\\\\Bum.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Bum Orb Song.ogg\",\n                \"Interface\\\\Sounds\\\\BumChristian.ogg\",\n                \"Interface\\\\Sounds\\\\Bumcocksaka.ogg\",\n                \"Interface\\\\Sounds\\\\Bum wtf.ogg\",\n                \n            },\n            chance=5\n        },\n        {\n            name = \"Stomp\",\n            texturePath={\"Interface\\\\Icons\\\\Stomp.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Stomp b word.ogg\",\n                \n                \n            },\n            chance=5\n        },\n        {\n            name = \"Fairy\",\n            texturePath={\"Interface\\\\Icons\\\\Fairyv2.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Fairy where is my kick.ogg\",\n                \"Interface\\\\Sounds\\\\Fairy wait wha.ogg\",\n                \n                \n            },\n            chance=3\n        },\n        {\n            name = \"Fairy\",\n            texturePath={\"Interface\\\\Icons\\\\Fairyv1.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Fairy where is my kick.ogg\",\n                \"Interface\\\\Sounds\\\\Fairy wait wha.ogg\",\n                \n                \n            },\n            chance=3\n        },\n        {\n            name = \"Arkhee\",\n            texturePath={\"Interface\\\\Icons\\\\Arkhee.tga\"},\n            soundPath={\n                \n                \"Interface\\\\Sounds\\\\Arkhee S tier weeb.ogg\",\n                \"Interface\\\\Sounds\\\\Arkhee not S tier weeb.ogg\",\n                \n                \n            },\n            chance=5\n        },\n        {\n            name = \"Vixy\",\n            texturePath={\"Interface\\\\Icons\\\\Vixyv2.tga\"},\n            soundPath={\n                \n                \"Interface\\\\Sounds\\\\Vixy gold fish.ogg\",\n                \n            },\n            chance=5\n        },\n        {\n            name = \"Wildi\",\n            texturePath={\"Interface\\\\Icons\\\\raal.tga\"},\n            soundPath={\n                \n                \"Interface\\\\Sounds\\\\Wildi Dinner Room.ogg\",\n                \n            },\n            chance=4\n        },\n        {\n            name = \"Stynik\",\n            texturePath={\"Interface\\\\Icons\\\\Stynik.tga\"},\n            soundPath={\n                \n                \"Interface\\\\Sounds\\\\Synik Camera Tutorial.ogg\",\n                \n            },\n            chance=5\n        },\n        \n    };\n    \n    scriptTable.comboDemons = {\n        \n        [\"Worben\"] = {\n            [\"Seri\"] = \"Interface\\\\Sounds\\\\Seri on Worbens Shoulder.ogg\",\n            [\"Hooker\"] =  \"Interface\\\\Sounds\\\\Arthur Worben.ogg\",\n            \n        },\n        [\"Hooker\"] = {\n            [\"Seri\"] = \"Interface\\\\Sounds\\\\Seri on Worbens Shoulder.ogg\",\n            [\"Hooker\"] = \"Interface\\\\Sounds\\\\Arthur Damage.ogg\",\n            [\"Arkhee\"] = \"Interface\\\\Sounds\\\\Arthur Arkhee combo.ogg\",\n            \n        },\n        [\"Shland\"] = {\n            [\"Shland\"] = \"Interface\\\\Sounds\\\\Shland we wasted 2 minutes.ogg\",\n        },\n        [\"Bumlock\"] = \n        {\n            [\"Bumlock\"] = \"Interface\\\\Sound\\\\Bum You have to fucking move.ogg\",\n            [\"Bumlock\"] = \"Interface\\\\Sounds\\\\Bum Kam.ogg\",\n        },\n        [\"Ivan\"] = \n        {\n            [\"Seri\"] = \"Interface\\\\Sounds\\\\Seri Ivan Broom.ogg\",\n            [\"Lang\"] = \"Interface\\\\Sounds\\\\Lang Ivan.ogg\",\n            [\"Hooker\"] = \"Interface\\\\Sounds\\\\Arthur Ivan.ogg\",\n            [\"Hooker\"] = \"Interface\\\\Sounds\\\\Arthur Ivan 2.ogg\",\n        },\n        [\"Seri\"] = \n        {\n            \n            [\"Seri\"] = \"Interface\\\\Sounds\\\\Seri combo Raid.ogg\",   \n            [\"Worben\"] = \"Interface\\\\Sounds\\\\Seri on Worbens Shoulder.ogg\",   \n        },\n        [\"Arkhee\"] = \n        {\n            \n            [\"Arkhee\"] = \"Interface\\\\Sounds\\\\Arkhee Softball Questions.ogg\",   \n            [\"Lang\"] = \"Interface\\\\Sounds\\\\Lang die arkhee.ogg\"\n        }\n    };\n    \n    scriptTable.weightedDemons = {};\n    for _,data in pairs(scriptTable.possibleDemons) do\n        for i=1,data.chance,1 do\n            tinsert(scriptTable.weightedDemons ,data);\n        end\n    end\n    \n    scriptTable.getRandomDemon = function()\n        return scriptTable.weightedDemons[math.random(#scriptTable.weightedDemons)];\n    end\n    \n    for who,combos in pairs(scriptTable.comboDemons) do\n        for combo,sound in pairs(combos)do\n            scriptTable.comboDemons[combo] = scriptTable.comboDemons[combo] or {};\n            if(not scriptTable.comboDemons[combo][who])then\n                scriptTable.comboDemons[combo][who] = sound;\n            end\n        end\n    end\n    \n    scriptTable.cleanUp = function()\n        local time = GetTime();\n        for key,data in pairs(scriptTable.currentlyActiveThings) do\n            if(data.startTime + scriptTable.thingFullDuration + 1 < time)then\n                scriptTable.currentlyActiveThings[key] = nil;\n            end\n        end\n    end\n    \n    scriptTable.getCombo = function(name)\n        for guid,data in pairs(scriptTable.currentlyActiveThings)do\n            if(scriptTable.comboDemons[name] and scriptTable.comboDemons[name][data.name])then\n                return scriptTable.comboDemons[name][data.name];\n            end\n        end\n        return nil;\n    end\n    \n    scriptTable.tableSize = function()\n        local counter = 0;\n        for _,_ in pairs(scriptTable.currentlyActiveThings) do\n            counter = counter + 1;\n        end\n        return counter;\n    end\n    \nend",
					["Time"] = 1647227665,
					["UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    if(scriptTable.currentlyActiveThings[envTable._UnitGUID])then\n        unitFrame.healthBar.unitName:SetText(scriptTable.currentlyActiveThings[envTable._UnitGUID].name);    \n    end\n    unitFrame.demonTexture:Show();\nend\n\n\n\n\n\n\n",
					["Temp_ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    \n    if(not unitFrame.demonTexture)then\n        unitFrame.demonTexture = unitFrame:CreateTexture(nil,\"ARTWORK\");\n        unitFrame.demonTexture:SetWidth(64);\n        unitFrame.demonTexture:SetHeight(64);\n        unitFrame.demonTexture:SetPoint(\"BOTTOM\",unitFrame,\"TOP\",0,3);\n    end\n    \n    if(not unitFrame.timerBar)then\n        unitFrame.timerBar = DetailsFramework:CreateBar(unitFrame);\n        unitFrame.timerBar:SetAllPoints(unitFrame.castBar);\n        unitFrame.timerBar:SetReverseFill();\n    end\nend\n\n\n\n\n",
					["NpcNames"] = {
						"Thing From Beyond", -- [1]
						"Illusionary Vulpin", -- [2]
