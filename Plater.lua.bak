					["Initialization"] = "function (scriptTable)\n    \n    scriptTable.showThingTimer = true;\n    scriptTable.playSound = true;   \n    \n    \n    -------------------------------------- DONT EDIT AFTER THIS LINE ------------------------------------------------\n    \n    local _;\n    scriptTable.currentlyActiveThings = {}; \n    scriptTable.thingFullDuration = 9.5;\n    \n    scriptTable.possibleDemons = {\n        \n        {\n            name = \"Ivan\", \n            texturePath={\"Interface\\\\Icons\\\\Ivan.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\NeckingSelf.ogg\",\n                \"Interface\\\\Sounds\\\\Ivan talk.ogg\",\n                \"Interface\\\\Sounds\\\\IvanRaider.ogg\",\n                \"Interface\\\\Sounds\\\\Ivan Tier.ogg\",\n            }, \n            chance=5\n        },\n        {\n            name = \"Cis\", \n            texturePath={\"Interface\\\\Icons\\\\Cis.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\CisWhy.ogg\",\n                \"Interface\\\\Sounds\\\\CisHit.ogg\",\n            }, \n            chance=0\n        },\n        {\n            name = \"Poli\", \n            texturePath={\"Interface\\\\Icons\\\\Poli.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Polirword.ogg\",\n                --\"Interface\\\\Sounds\\\\IvanRaider.ogg\",\n            }, \n            chance=5\n        },\n        {\n            name = \"Lang\",\n            texturePath={\"Interface\\\\Icons\\\\lang.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\langMan.ogg\",\n                \"Interface\\\\Sounds\\\\lang Laugh.ogg\"\n            },\n            chance=5\n        },\n        {\n            name = \"Sarer\",\n            texturePath={\"Interface\\\\Icons\\\\sarer.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\sarerWhore.ogg\",\n                \"Interface\\\\Sounds\\\\sarerLikeSubComment.ogg\",\n            },\n            chance=5\n        },\n        {\n            name = \"Gem\",\n            texturePath={\"Interface\\\\Icons\\\\gem.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\gemOpenEye.ogg\",\n                --\"Interface\\\\Sounds\\\\JulietGem.ogg\",\n            },\n            chance=5\n        },\n        {\n            name = \"Hooker\",\n            texturePath={\"Interface\\\\Icons\\\\ArthurW.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\monkaS.ogg\",\n                \"Interface\\\\Sounds\\\\EZBoss.ogg\",\n            },\n            chance=5\n        },\n        {\n            name = \"Madman\",\n            texturePath={\"Interface\\\\Icons\\\\Madman.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Madman Gosh.ogg\",\n                \"Interface\\\\Sounds\\\\MadmanLord.ogg\"\n            },\n            chance=5\n        },\n        {\n            name = \"Worben\",\n            texturePath={\"Interface\\\\Icons\\\\Worben.tga\"},\n            soundPath={\"Interface\\\\Sounds\\\\worbenShoulda.ogg\"},\n            chance=5\n        },\n        {\n            name = \"Seri\",\n            texturePath={\"Interface\\\\Icons\\\\Seri.tga\"},\n            soundPath={\"Interface\\\\Sounds\\\\Seri on Worbens Shoulder.ogg\"},\n            chance=5\n        },\n        {\n            name = \"Gump\",\n            texturePath={\"Interface\\\\Icons\\\\Gump.tga\"},\n            soundPath={\"Interface\\\\Sounds\\\\Gump Count.ogg\"},\n            chance=5\n        },\n        {\n            name = \"Shland\",\n            texturePath={\"Interface\\\\Icons\\\\Shland.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Shland Route.ogg\",\n                \"Interface\\\\Sounds\\\\Shland Touch my cc.ogg\"\n            },\n            chance=5\n        },\n        {\n            name = \"Bumlock\",\n            texturePath={\"Interface\\\\Icons\\\\Bum.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Bum Orb Song.ogg\",\n                \"Interface\\\\Sounds\\\\BumChristian.ogg\",\n                \"Interface\\\\Sounds\\\\Bumcocksaka.ogg\",\n                \"Interface\\\\Sounds\\\\Bum wtf.ogg\",\n                \n            },\n            chance=5\n        },\n        {\n            name = \"Stomp\",\n            texturePath={\"Interface\\\\Icons\\\\Stomp.tga\"},\n            soundPath={\n                \"Interface\\\\Sounds\\\\Bum Orb Song.ogg\",\n                \"Interface\\\\Sounds\\\\BumChristian.ogg\"\n                \n            },\n            chance=0\n        },\n        \n    };\n    \n    scriptTable.comboDemons = {\n        [\"Worben\"] = {\n            [\"Seri\"] = \"Interface\\\\Sounds\\\\Seri on Worbens Shoulder.ogg\",\n            \n        },\n        [\"Shland\"] = {\n            [\"Shland\"] = \"Interface\\\\Sounds\\\\Shland we wasted 2 minutes.ogg\",\n        },\n        [\"Bumlock\"] = \n        {\n            [\"Bumlock\"] = \"Interface\\\\Sound\\\\Bum You have to fucking move.ogg\",\n            [\"Bumlock\"] = \"Interface\\\\Sounds\\\\Bum Kam.ogg\",\n        },\n        [\"Ivan\"] = \n        {\n            [\"Seri\"] = \"Interface\\\\Sounds\\\\Seri Ivan Broom.ogg\",\n            [\"Lang\"] = \"Interface\\\\Sounds\\\\Lang Ivan.ogg\",\n        },\n    };\n    \n    scriptTable.weightedDemons = {};\n    for _,data in pairs(scriptTable.possibleDemons) do\n        for i=1,data.chance,1 do\n            tinsert(scriptTable.weightedDemons ,data);\n        end\n    end\n    \n    scriptTable.getRandomDemon = function()\n        return scriptTable.weightedDemons[math.random(#scriptTable.weightedDemons)];\n    end\n    \n    for who,combos in pairs(scriptTable.comboDemons) do\n        for combo,sound in pairs(combos)do\n            scriptTable.comboDemons[combo] = scriptTable.comboDemons[combo] or {};\n            if(not scriptTable.comboDemons[combo][who])then\n                scriptTable.comboDemons[combo][who] = sound;\n            end\n        end\n    end\n    \n    scriptTable.cleanUp = function()\n        local time = GetTime();\n        for key,data in pairs(scriptTable.currentlyActiveThings) do\n            if(data.startTime + scriptTable.thingFullDuration + 1 < time)then\n                scriptTable.currentlyActiveThings[key] = nil;\n            end\n        end\n    end\n    \n    scriptTable.getCombo = function(name)\n        for guid,data in pairs(scriptTable.currentlyActiveThings)do\n            if(scriptTable.comboDemons[name] and scriptTable.comboDemons[name][data.name])then\n                return scriptTable.comboDemons[name][data.name];\n            end\n        end\n        return nil;\n    end\n    \n    scriptTable.tableSize = function()\n        local counter = 0;\n        for _,_ in pairs(scriptTable.currentlyActiveThings) do\n            counter = counter + 1;\n        end\n        return counter;\n    end\n    \nend",
					["Desc"] = "They are coming for you.",
					["Temp_UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    if(scriptTable.currentlyActiveThings[envTable._UnitGUID])then\n        unitFrame.healthBar.unitName:SetText(scriptTable.currentlyActiveThings[envTable._UnitGUID].name);    \n    end\n    unitFrame.demonTexture:Show();\nend\n\n\n\n\n\n\n",
					["Prio"] = 99,
					["Name"] = "Friendly Banter Pepega(ty method)",
					["PlaterCore"] = 1,
					["SpellIds"] = {
					},
					["version"] = 2,
					["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    \n    scriptTable.cleanUp();\n    \n    local demonData;\n    if(not scriptTable.currentlyActiveThings[envTable._UnitGUID])then\n        demonData = scriptTable.getRandomDemon();\n        \n        if(scriptTable.playSound)then\n            local useCombo = scriptTable.tableSize(scriptTable.currentlyActiveThings) > 0;\n            local combo = scriptTable.getCombo(demonData.name);\n            \n            if(useCombo and combo)then\n                PlaySoundFile(combo,\"MASTER\");\n            else\n                if(#demonData.soundPath > 0)then\n                    PlaySoundFile(demonData.soundPath[math.random(#demonData.soundPath)],\"MASTER\");\n                end\n            end\n        end\n        \n        demonData.startTime = GetTime();\n        demonData.currentTexture = demonData.texturePath[math.random(#demonData.texturePath)];\n        \n        scriptTable.currentlyActiveThings[envTable._UnitGUID] = demonData;\n    else\n        demonData = scriptTable.currentlyActiveThings[envTable._UnitGUID];\n    end\n    \n    if(scriptTable.showThingTimer and demonData.startTime + scriptTable.thingFullDuration > GetTime())then\n        unitFrame.timerBar:SetTimer(demonData.startTime,demonData.startTime + scriptTable.thingFullDuration);\n        unitFrame.timerBar:Show();\n    end\n    \n    unitFrame.demonTexture:SetTexture(demonData.currentTexture); \n    unitFrame.healthBar.unitName:SetText(scriptTable.currentlyActiveThings[envTable._UnitGUID].name);\n    unitFrame.demonTexture:Show();\nend",
					["NpcNames"] = {
						"Thing From Beyond", -- [1]
					},
				}, -- [24]
				{
					["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    --castbar color (when can be interrupted)\n    envTable.CastbarColor = scriptTable.config.castbarColor\n    \n    --flash duration\n    local CONFIG_BACKGROUND_FLASH_DURATION = scriptTable.config.flashDuration\n    \n    --add this value to the cast bar height\n    envTable.CastBarHeightAdd = scriptTable.config.castBarHeight\n    \n    --create a fast flash above the cast bar\n    envTable.FullBarFlash = envTable.FullBarFlash or Plater.CreateFlash (self, 0.05, 1, \"white\")\n    \n    --create a camera shake for the nameplate\n    envTable.FrameShake = Plater:CreateFrameShake (unitFrame, scriptTable.config.shakeDuration, scriptTable.config.shakeAmplitude, scriptTable.config.shakeFrequency, false, false, 0, 1, 0.05, 0.1, Plater.GetPoints (unitFrame))\n    \n    --create a texture to use for a flash behind the cast bar\n    local backGroundFlashTexture = Plater:CreateImage (self, [[Interface\\ACHIEVEMENTFRAME\\UI-Achievement-Alert-Glow]], self:GetWidth()+60, self:GetHeight()+50, \"background\", {0, 400/512, 0, 170/256})\n    backGroundFlashTexture:SetBlendMode (\"ADD\", 7)\n    backGroundFlashTexture:SetDrawLayer(\"OVERLAY\", 7)\n    backGroundFlashTexture:SetPoint (\"center\", self, \"center\")\n    backGroundFlashTexture:Hide()\n    \n    --create the animation hub to hold the flash animation sequence\n    envTable.BackgroundFlash = envTable.BackgroundFlash or Plater:CreateAnimationHub (backGroundFlashTexture, \n        function()\n            backGroundFlashTexture:Show()\n        end,\n        function()\n            backGroundFlashTexture:Hide()\n        end\n    )\n    \n    --create the flash animation sequence\n    envTable.BackgroundFlash.fadeIn = envTable.BackgroundFlash.fadeIn or Plater:CreateAnimation (envTable.BackgroundFlash, \"ALPHA\", 1, CONFIG_BACKGROUND_FLASH_DURATION/2, 0, .75)\n    envTable.BackgroundFlash.fadeIn:SetDuration(CONFIG_BACKGROUND_FLASH_DURATION/2)\n    \n    envTable.BackgroundFlash.fadeOut = envTable.BackgroundFlash.fadeOut or Plater:CreateAnimation (envTable.BackgroundFlash, \"ALPHA\", 2, CONFIG_BACKGROUND_FLASH_DURATION/2, 1, 0)    \n    envTable.BackgroundFlash.fadeOut:SetDuration(CONFIG_BACKGROUND_FLASH_DURATION/2)\n    \n    --envTable.BackgroundFlash:Play() --envTable.BackgroundFlash:Stop()    \n    \n    \n    \n    \n    \nend\n\n\n\n\n",
					["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    \n    unitFrame.castBar:SetHeight (envTable._DefaultHeight)\n    \n    --stop the camera shake\n    unitFrame:StopFrameShake (envTable.FrameShake)\n    \n    envTable.FullBarFlash:Stop()\n    envTable.BackgroundFlash:Stop()\n    \n    unitFrame.castBar.Spark:SetHeight(unitFrame.castBar:GetHeight())\n    \n    --check if there's a timer for this spell\n    local timer = scriptTable.config.timerList[tostring(envTable._SpellID)]\n    \n    if (timer) then\n        --insert code here\n        \n        --set the castbar config\n        local config = {\n            iconTexture = \"\",\n            iconTexcoord = {0.1, 0.9, 0.1, 0.9},\n            iconAlpha = 1,\n            iconSize = 14,\n            \n            text = \"Spikes Incoming!\",\n            textSize = 8,\n            \n            texture = [[Interface\\AddOns\\Plater\\images\\bar_background]],\n            color = {.6, .6, .6, 0.8},\n            \n            isChanneling = false,\n            canInterrupt = false,\n            \n            height = 5,\n            width = Plater.db.profile.plate_config.enemynpc.health_incombat[1],\n            \n            spellNameAnchor = {side = 3, x = 0, y = -2},\n            timerAnchor = {side = 5, x = 0, y = -2},\n        }\n        \n        Plater.SetAltCastBar(unitFrame.PlateFrame, config, timer, nil, nil)\n        local castBar2 = unitFrame.castBar2\n        castBar2.Text:ClearAllPoints()\n        castBar2.Text:SetPoint (\"topleft\", castBar2, \"bottomleft\", 0, 0)\n        castBar2.percentText:ClearAllPoints()\n        castBar2.percentText:SetPoint (\"topright\", castBar2, \"bottomright\", 0, 0)\n        Plater:SetFontSize(castBar2.percentText, 8)\n    end\n    \nend\n\n\n\n\n\n\n\n",
					["OptionsValues"] = {
					},
					["ScriptType"] = 2,
					["UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    \nend\n\n\n",
					["Time"] = 1626467946,
					["url"] = "",
					["Icon"] = "Interface\\AddOns\\Plater\\images\\cast_bar_orange",
					["Enabled"] = true,
					["Revision"] = 1162,
					["semver"] = "",
					["Author"] = "Tercioo-Sylvanas",
					["Initialization"] = "function (scriptTable)\n    --insert code here\n    \nend",
					["Desc"] = "Player an animation when the cast start. Start a timer when the cast finishes. Set the time in the options.",
					["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\n    \n    --play flash animations\n    envTable.FullBarFlash:Play()\n    \n    --envTable.currentHeight = unitFrame.castBar:GetHeight()\n    \n    --restoring the default size (not required since it already restore in the hide script)\n    if (envTable.OriginalHeight) then\n        self:SetHeight (envTable.OriginalHeight)\n    end\n    \n    --increase the cast bar size\n    local height = self:GetHeight()\n    envTable.OriginalHeight = height\n    \n    self:SetHeight (height + envTable.CastBarHeightAdd)\n    \n    Plater.SetCastBarBorderColor (self, 1, .2, .2, 0.4)\n    \n    unitFrame:PlayFrameShake (envTable.FrameShake)\n    \n    --set the color of the cast bar to dark orange (only if can be interrupted)\n    --Plater auto set this color to default when a new cast starts, no need to reset this value at OnHide.    \n    if (envTable._CanInterrupt) then\n        if (scriptTable.config.useCastbarColor) then\n            self:SetStatusBarColor (Plater:ParseColors (envTable.CastbarColor))\n        end\n    end\n    \n    envTable.BackgroundFlash:Play()\n    \n    unitFrame.castBar.Spark:SetHeight(unitFrame.castBar:GetHeight())\n    \nend\n\n\n\n\n\n\n\n\n\n\n",
