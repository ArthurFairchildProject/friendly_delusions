				}, -- [2]
				{
					["Enabled"] = false,
					["Revision"] = 58,
					["OptionsValues"] = {
					},
					["HooksTemp"] = {
					},
					["Author"] = "Rehokk-Tarren Mill",
					["LastHookEdited"] = "Nameplate Updated",
					["Desc"] = "",
					["Hooks"] = {
						["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable)\n    \n    \n    \n    \n    local guid = unitFrame.namePlateUnitGUID\n    local id = select(6,strsplit(\"-\",guid))\n    if id == \"137713\" then\n        Plater.SetNameplateColor (unitFrame, \"green\" )\n        \n        local spawnID = select(7,strsplit(\"-\", guid))\n        local spawnDec = tonumber(\"0x\"..spawnID)\n        local text = unitFrame.healthBar.lifePercent\n        text:SetText(spawnID)\n    else\n        Plater.RefreshNameplateColor (unitFrame)\n        local text = unitFrame.healthBar.lifePercent\n        text:SetText(\"\")\n    end\n    \n    \n    \nend",
					},
					["Time"] = 1575478121,
					["PlaterCore"] = 1,
					["Name"] = "Show Spawn ID ",
					["LoadConditions"] = {
						["talent"] = {
						},
						["group"] = {
						},
						["class"] = {
						},
						["map_ids"] = {
